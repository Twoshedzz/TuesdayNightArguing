---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ChapterIllustration from '../components/ChapterIllustration.astro';
import ChapterNav from '../components/ChapterNav.astro';
import ChapterBodyLightbox from '../components/ChapterBodyLightbox.astro';
import ChapterBlocks from '../components/ChapterBlocks.astro';

interface Props {
  chapter: CollectionEntry<'chapters'>;
  prev?: CollectionEntry<'chapters'>;
  next?: CollectionEntry<'chapters'>;
}

const { chapter, prev, next } = Astro.props;
const { title, chapter: chapterNumber, summary, coverIllustration, book } = chapter.data;

const place = {
  slug: chapter.slug,
  book,
  chapter: chapterNumber,
  title,
};
---

<script is:inline define:vars={{ place }}>
  /*
   * Remember where the reader got to, so the cover can offer to put them back.
   *
   * Only if they agreed to be remembered — the same rule the cover choice follows.
   * It never leaves the browser, and a reader who declined simply gets no offer.
   */
  try {
    if (window.localStorage.getItem('tna-analytics') === 'granted') {
      window.localStorage.setItem('tna-reading', JSON.stringify(place));
    }
  } catch (e) {
    /* private window or blocked storage — nothing to remember with */
  }
</script>

<BaseLayout title={title} description={summary}>
  <SiteHeader slot="header" />

  <article class="container">
    <header class="chapter-header">
      <p class="chapter-header__number">
        {chapterNumber === 0 ? 'Prologue' : `Chapter ${chapterNumber}`}
      </p>
      <h1 class="chapter-header__title">{title}</h1>
      {summary && <p class="chapter-header__summary">{summary}</p>}
    </header>

    {coverIllustration && (
      <ChapterIllustration
        src={coverIllustration}
        alt={`Illustration for ${title}`}
        variant="cover"
      />
    )}

    <div class="chapter-body">
      <ChapterBlocks blocks={chapter.data.blocks} />
    </div>

    <ChapterBodyLightbox />

    <ChapterNav prev={prev} next={next} />
  </article>
</BaseLayout>
