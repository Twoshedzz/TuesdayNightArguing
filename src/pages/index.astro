---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverHero from '../components/CoverHero.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getPublishedChapters, formatChapterLabel } from '../lib/chapters';
import { SITE_TITLE } from '../lib/site';

const chapters = await getPublishedChapters();
const firstChapter = chapters[0];
---

<BaseLayout title={SITE_TITLE}>
  <SiteHeader slot="header" />

  <div class="container container--cover">
    <CoverHero
      covers={[
        {
          id: 'first',
          label: 'First edition',
          image: '/illustrations/cover/cover-the-pit.jpg',
          aspect: '3 / 2',
          aspectNarrow: '1 / 1',
          maxWidth: '54rem',
          // Wide and busy: no strapline over the figures, and a scrim that reaches
          // only as far as the button needs.
          showLede: false,
          scrimTop: '40%',
          scrimBottom: '34%',
        },
        {
          id: 'second',
          label: 'Second edition',
          image: '/illustrations/cover/cover-noct-in-the-doorway.jpg',
          aspect: '5 / 7',
          aspectNarrow: '4 / 5',
          maxWidth: '42rem',
        },
      ]}
      eyebrow="A Dungeons &amp; Dragons campaign, told twice"
      title={SITE_TITLE}
      lede="One campaign, as told by a bard who was there and a man who was on a call."
      ctaLabel={firstChapter ? 'Begin reading' : undefined}
      ctaHref={firstChapter ? `/chapters/${firstChapter.slug}/` : undefined}
    />

    <p class="cover__lede">
      Noct Strigbart, dwarf bard, recounts the finest hour of his life. The man playing
      him is in a box room in Lancashire with the door shut, and somebody's wife has just
      come in to ask about radiators.
    </p>

    {!firstChapter && <p class="cover__empty">No chapters published yet.</p>}

    {
      chapters.length > 0 && (
        <ul class="chapter-list">
          {chapters.map((chapter) => (
            <li>
              <a href={`/chapters/${chapter.slug}/`}>
                <span class="chapter-list__number">
                  {formatChapterLabel(chapter.data.chapter)}
                </span>
                <span class="chapter-list__title">{chapter.data.title}</span>
                {chapter.data.summary && (
                  <span class="chapter-list__summary">{chapter.data.summary}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
