---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverHero from '../components/CoverHero.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getPublishedChapters, formatChapterLabel } from '../lib/chapters';
import { SITE_TITLE } from '../lib/site';

/**
 * One panel of chapters per book, shown and hidden by the same switch that
 * changes the cover — so choosing a book changes what there is to read, not just
 * the picture above it.
 */
const books = [
  { id: 'book-one', number: 1 },
  { id: 'book-two', number: 2 },
];

const chaptersByBook = await Promise.all(
  books.map(async (book) => ({
    ...book,
    chapters: await getPublishedChapters(book.number),
  })),
);

const firstChapter = chaptersByBook[0].chapters[0];
---

<BaseLayout title={SITE_TITLE} coverHero>
  <SiteHeader slot="header" />

    <CoverHero
    covers={[
      {
        id: 'book-one',
        label: 'One',
        book: 1,
        image: '/illustrations/cover/cover-the-pit.jpg',
        bleed: true,
        aspect: '3 / 2',
        aspectNarrow: '1 / 1',
        maxWidth: 'none',
        // Keeps the figures in frame when the band crops top and bottom.
        focus: 'center 46%',
        showLede: true,
      },
      {
        id: 'book-two',
        label: 'Two',
        book: 2,
        image: '/illustrations/cover/cover-noct-in-the-doorway.jpg',
        aspect: '5 / 7',
        aspectNarrow: '4 / 5',
        maxWidth: '42rem',
        strapline: 'The table sits down again. Nobody has learned anything.',
        // No way in: this one has not been played yet.
        status: 'Coming at Christmas',
      },
    ]}
    eyebrow="A Dungeons &amp; Dragons campaign, told twice"
    title={SITE_TITLE}
    lede="One campaign, as told by a bard who was there and a man who was on a call."
    ctaLabel={firstChapter ? 'Begin reading' : undefined}
    ctaHref={firstChapter ? `/chapters/${firstChapter.slug}/` : undefined}
  />

  <div class="container container--cover">
    <p class="cover__lede">
      Noct Strigbart, dwarf bard, recounts the finest hour of his life. The man playing
      him is in a box room in York with the door shut, and somebody's wife has just
      come in to ask about radiators.
    </p>

    {
      chaptersByBook.map((book, i) => (
        <section data-book-panel={book.id} hidden={i !== 0}>
          {book.chapters.length > 0 ? (
            <ul class="chapter-list">
              {book.chapters.map((chapter) => (
                <li>
                  <a href={`/chapters/${chapter.slug}/`}>
                    <span class="chapter-list__number">
                      {formatChapterLabel(chapter.data.chapter)}
                    </span>
                    <span class="chapter-list__title">{chapter.data.title}</span>
                    {chapter.data.summary && (
                      <span class="chapter-list__summary">{chapter.data.summary}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="cover__empty">
              Not written yet — the table has not sat down.{' '}
              <button type="button" class="cover__empty-link" data-go-book="book-one">
                Book one
              </button>{' '}
              is where to start.
            </p>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>
