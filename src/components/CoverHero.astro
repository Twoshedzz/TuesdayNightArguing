---
/**
 * The cover, as a cover — and there is more than one.
 *
 * Each cover is a plate: the art as a background with the title, the strapline
 * and the way in set over it. Title block high, the way in low where a
 * publisher's mark would sit.
 *
 * Scaling is the whole problem. A cover is a fixed set of proportions, and type
 * sized in rem stops being a cover the moment the plate is any other size. So each
 * plate is its own container and everything on it is sized in `cqi` — a percentage
 * of that plate's width — which holds the composition identically on a phone and
 * on a desktop. The clamps keep it readable at one end and sane at the other.
 *
 * The art is a background rather than an <img> because it is decoration: the title
 * is real text above it, which is what a screen reader and a search engine find.
 *
 * Every plate is rendered. The toggle swaps which one is shown and remembers the
 * choice per reader, and it only appears once the script has run — without
 * JavaScript the first cover shows and there is no dead control.
 */
interface Cover {
  id: string;
  image: string;
  label: string;
  /** Plate proportions, e.g. '5 / 7'. */
  aspect: string;
  /** How wide the plate may grow. A landscape plate wants more room. */
  maxWidth: string;
  /** Narrow-screen proportions, when the printed shape is too tall or too wide. */
  aspectNarrow?: string;
  /**
   * How far the scrims reach, as a percentage of plate height. A short plate puts
   * the same type block over more of the picture, so it needs them to reach further.
   */
  scrimTop?: string;
  scrimBottom?: string;
  /**
   * Whether this plate carries the strapline. A wide plate puts it straight over
   * the figures, and the fuller version sits directly below the cover anyway —
   * so the art is worth more than the repetition.
   */
  showLede?: boolean;
  /**
   * Break out of the page column and run edge to edge. A bleed plate is a band
   * rather than a book: it caps its height instead of holding proportions, sets
   * its type to one side so the picture keeps its middle, and scales from the
   * viewport rather than from its own width.
   */
  bleed?: boolean;
  /** background-position, for keeping the right part of the picture in frame. */
  focus?: string;
  /** This book's own strapline, if it differs from the shared one. */
  strapline?: string;
  /** Where this book starts. Omit for a book that cannot be read yet. */
  ctaLabel?: string;
  ctaHref?: string;
  /** Shown in place of the way in — "Coming at Christmas" and the like. */
  status?: string;
  /** Which book this cover is, matching the chapter frontmatter. */
  book?: number;
}

interface Props {
  covers: Cover[];
  eyebrow?: string;
  title: string;
  lede?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { covers, eyebrow, title, lede, ctaLabel, ctaHref } = Astro.props;
---

<div class="covers" data-covers>
  {
    covers.map((cover, i) => (
      <section
        class:list={['plate', cover.bleed && 'plate--bleed', cover.status && 'plate--flashed']}
        data-cover={cover.id}
        data-bleed={cover.bleed ? 'true' : undefined}
        data-book={cover.book}
        hidden={i !== 0}
        style={`--plate-art: url('${cover.image}'); --plate-aspect: ${cover.aspect}; --plate-max: ${cover.maxWidth}; --plate-aspect-narrow: ${cover.aspectNarrow ?? cover.aspect}; --scrim-top: ${cover.scrimTop ?? '44%'}; --scrim-bottom: ${cover.scrimBottom ?? '48%'}; --plate-focus: ${cover.focus ?? 'center'}`}
      >
        <div class="plate__backdrop" aria-hidden="true" />
        <div class="plate__art" aria-hidden="true" />

        <div class="plate__type">
          {/*
            The bleed cover borrows the masthead as its title — it sits over the
            picture, so repeating it here would be saying it twice. Every other
            plate carries its own, as a <p>: the page's single <h1> is the
            masthead's, either way.
          */}
          {!cover.bleed && (
            <header class="plate__head">
              {eyebrow && <p class="plate__eyebrow">{eyebrow}</p>}
              <p class="plate__title">{title}</p>
            </header>
          )}

          <footer class="plate__foot">
            {cover.showLede !== false && (cover.strapline ?? lede) && (
              <p class="plate__lede">{cover.strapline ?? lede}</p>
            )}

            {/*
              A book you can read gets a way in. One you cannot says so on a flash
              across the corner instead — nothing button-shaped that isn't a button.
            */}
            {!cover.status &&
              (cover.ctaHref ?? ctaHref) &&
              (cover.ctaLabel ?? ctaLabel) && (
                <a class="plate__cta" href={cover.ctaHref ?? ctaHref}>
                  {cover.ctaLabel ?? ctaLabel}
                </a>
              )}
          </footer>
        </div>

        {cover.status && <p class="plate__flash">{cover.status}</p>}
      </section>
    ))
  }

  {
    covers.length > 1 && (
      <p class="covers__resume" data-resume hidden>
        <a href="/" data-resume-link></a>
      </p>

      <div class="covers__switch" data-cover-switch hidden>
        <span class="covers__label">Book</span>
        {covers.map((cover, i) => (
          <button
            type="button"
            class="covers__button"
            data-cover-choose={cover.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {cover.label}
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  /**
   * The switch chooses which book you are looking at. What is remembered is not
   * that choice but where you got to reading — so coming back offers you your
   * place rather than a picture you once clicked.
   *
   * Nothing is written unless the reader agreed to be remembered, and none of it
   * leaves their browser. Storage can throw outright in a private window, so every
   * touch of it is wrapped and the page works without it.
   */
  const root = document.querySelector('[data-covers]');
  if (root) {
    const PLACE = 'tna-reading';
    const plates = Array.from(root.querySelectorAll<HTMLElement>('[data-cover]'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cover-choose]'));
    const bar = root.querySelector<HTMLElement>('[data-cover-switch]');
    const resume = root.querySelector<HTMLElement>('[data-resume]');
    const resumeLink = root.querySelector<HTMLAnchorElement>('[data-resume-link]');

    const mayRemember = () => {
      try {
        return window.localStorage.getItem('tna-analytics') === 'granted';
      } catch {
        return false;
      }
    };

    const readPlace = () => {
      if (!mayRemember()) return null;
      try {
        const raw = window.localStorage.getItem(PLACE);
        return raw ? JSON.parse(raw) : null;
      } catch {
        return null;
      }
    };

    const show = (id: string) => {
      if (!plates.some((plate) => plate.dataset.cover === id)) return;

      for (const plate of plates) plate.hidden = plate.dataset.cover !== id;
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.coverChoose === id));
      }

      // Only the bleed cover runs to the top of the page with the masthead over it.
      const chosen = plates.find((plate) => plate.dataset.cover === id);
      document
        .querySelector('.site-shell')
        ?.classList.toggle('site-shell--hero', chosen?.dataset.bleed === 'true');

      // Choosing a book changes what there is to read, not only the picture.
      for (const panel of document.querySelectorAll<HTMLElement>('[data-book-panel]')) {
        panel.hidden = panel.dataset.bookPanel !== id;
      }
    };

    /** Offer the reader their place back, on the book it belongs to. */
    const offerPlace = () => {
      const place = readPlace();
      if (!place?.slug || !resume || !resumeLink) {
        if (resume) resume.hidden = true;
        return;
      }

      const plate = plates.find((p) => Number(p.dataset.book) === Number(place.book));
      if (plate?.dataset.cover) show(plate.dataset.cover);

      const label = place.chapter === 0 ? 'the prologue' : `chapter ${place.chapter}`;
      resumeLink.href = `/chapters/${place.slug}/`;
      resumeLink.textContent = place.title
        ? `Carry on from ${label} — ${place.title}`
        : `Carry on from ${label}`;
      resume.hidden = false;
    };

    offerPlace();

    for (const button of buttons) {
      button.addEventListener('click', () => show(button.dataset.coverChoose ?? ''));
    }

    /**
     * Consent can change after the page has loaded. Withdrawing it clears the place
     * that was kept and takes the offer away, rather than leaving it to be read on
     * the next visit.
     */
    window.addEventListener('tna:consent', (event) => {
      const answer = (event as CustomEvent).detail;
      try {
        if (answer === 'granted') {
          offerPlace();
        } else {
          window.localStorage.removeItem(PLACE);
          if (resume) resume.hidden = true;
        }
      } catch {
        /* nothing kept either way */
      }
    });

    // The old key remembered a picture. It is not what we keep any more.
    try {
      window.localStorage.removeItem('tna-cover');
    } catch {
      /* nothing to tidy */
    }

    // Only now is the control worth showing.
    if (bar) bar.hidden = false;
  }
</script>

<style>
  .covers {
    margin-bottom: 2.5rem;
    padding-inline: 20px;
  }

  .plate {
    container-type: inline-size;
    position: relative;
    width: 100%;
    max-width: var(--plate-max, 42rem);
    margin: 0 auto;
    aspect-ratio: var(--plate-aspect, 5 / 7);
    overflow: hidden;
    background: #241a12;
    border: 1px solid var(--rule, #b5a584);
  }

  .plate[hidden] {
    display: none !important;
  }

  .plate__art {
    position: absolute;
    inset: 0;
    background-image: var(--plate-art);
    background-size: cover;
    background-position: var(--plate-focus, center);
  }

  /* Only a bleed plate needs one; see below. */
  .plate__backdrop {
    display: none;
  }

  /*
   * Two scrims rather than one flat wash, so the painting keeps its middle and
   * only the ends darken under the type.
   */
  .plate__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgb(12 6 4 / 0.78) 0%,
        rgb(12 6 4 / 0.3) calc(var(--scrim-top, 44%) * 0.6),
        rgb(12 6 4 / 0) var(--scrim-top, 44%)
      ),
      linear-gradient(
        to top,
        rgb(12 6 4 / 0.88) 0%,
        rgb(12 6 4 / 0.5) calc(var(--scrim-bottom, 48%) * 0.45),
        rgb(12 6 4 / 0) var(--scrim-bottom, 48%)
      );
  }

  .plate__type {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 5cqi 6cqi;
    text-align: center;
    color: #f5ead6;
  }

  /* The flash cuts across the top corner, so the head starts below it. */
  .plate--flashed .plate__type {
    padding-top: 11cqi;
  }

  .plate__eyebrow {
    margin: 0 0 1.4cqi;
    font-family: var(--ui, system-ui, sans-serif);
    font-size: clamp(0.58rem, 2.3cqi, 0.95rem);
    font-weight: 600;
    /* Tracking this wide forces an ugly break on a narrow plate, so it eases off. */
    letter-spacing: clamp(0.08em, 0.5cqi, 0.18em);
    text-transform: uppercase;
    text-wrap: balance;
    color: #e8b88a;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.85);
  }

  /*
   * Same register as the masthead over the bleed cover: heavy gold caps cut out of
   * the picture with a dark edge. The edge is both the look and what keeps the
   * words legible over paint, which is why the scrims can stay light.
   *
   * Caps run wider than mixed case, so the size steps down to suit.
   */
  .plate__title {
    margin: 0;
    font-family: var(--slab, Georgia, serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 9cqi, 4.2rem);
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    text-wrap: balance;
    color: #f0c24a;
    text-shadow:
      -1px -1px 0 #1a0d04,
      1px -1px 0 #1a0d04,
      -1px 1px 0 #1a0d04,
      1px 1px 0 #1a0d04,
      -2px 0 0 #1a0d04,
      2px 0 0 #1a0d04,
      0 -2px 0 #1a0d04,
      0 2px 0 #1a0d04,
      0 3px 6px rgb(0 0 0 / 0.85),
      0 0 28px rgb(0 0 0 / 0.5);
  }

  .plate__lede {
    margin: 0 auto 3cqi;
    max-width: 34ch;
    font-family: var(--serif, Georgia, serif);
    font-size: clamp(0.78rem, 3.1cqi, 1.1rem);
    line-height: 1.45;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.95);
  }

  .plate__cta {
    display: inline-block;
    padding: 1.6cqi 5cqi;
    border: 1px solid #e8b88a;
    background: rgb(12 6 4 / 0.6);
    color: #f5ead6;
    font-family: var(--ui, system-ui, sans-serif);
    font-size: clamp(0.72rem, 2.8cqi, 1rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .plate__cta:hover,
  .plate__cta:focus-visible {
    background: #e8b88a;
    color: #241a12;
  }

  /*
   * A flash across the top corner, the way a paperback announces itself. Sized in
   * cqi so it keeps its proportion to the plate, and clipped by the plate's own
   * overflow so the ends disappear off the corner rather than being drawn to fit.
   */
  .plate__flash {
    position: absolute;
    top: 9cqi;
    left: -15cqi;
    width: 54cqi;
    margin: 0;
    padding: 1.2cqi 0;
    transform: rotate(-45deg);
    background: #f0c24a;
    color: #1a0d04;
    font-family: var(--ui, system-ui, sans-serif);
    font-size: clamp(0.55rem, 2cqi, 0.9rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.5);
    z-index: 4;
  }

  /*
   * A bleed plate is far wider than it is tall, so cqi — a share of its width —
   * would throw the flash halfway across the band. It takes fixed sizing there.
   */
  .plate--bleed .plate__flash {
    top: 3.2rem;
    left: -5.5rem;
    width: 19rem;
    padding: 0.4rem 0;
    font-size: 0.72rem;
  }

  /* ── full bleed ─────────────────────────────────────────────────────────── */

  /*
   * Edge to edge, out of the page column. A band has no fixed proportions, so it
   * takes a capped height instead and lets the picture crop — which is why the
   * focus point is settable per cover.
   */
  /*
   * Full width without 100vw. A viewport unit includes the scrollbar, so a 100vw
   * band is always a few pixels wider than the space it has and the page scrolls
   * sideways. The cover sits outside the page column instead and simply cancels
   * the wrapper's gutter, which no scrollbar can affect.
   */
  .plate--bleed {
    width: auto;
    max-width: none;
    margin-inline: -20px;
    aspect-ratio: auto;
    /*
     * The headroom is added to the band rather than taken out of the picture.
     * The art is fitted to the band minus this strip, so without the extra height
     * the clearance above the demon would come straight off the painting's size.
     */
    --headroom: clamp(2rem, 5.5vh, 3.5rem);
    height: calc(clamp(24rem, 74vh, 44rem) + var(--headroom));
    border-left: 0;
    border-right: 0;
  }

  /*
   * A wide band and a 3:2 painting cannot both have their way: edge to edge on a
   * 2000px screen, `cover` scales the picture to 1300px tall and throws away a
   * third of it — which is exactly where Noct and the demon's head live.
   *
   * So the painting is fitted whole inside the band instead, and the space either
   * side is filled with a blurred, darkened copy of itself. No crop, no letterbox
   * bars, and no seam where a flat colour would meet the rock.
   */
  .plate--bleed .plate__art {
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    /*
     * Headroom for the masthead. The picture is fitted to its content box, so
     * padding at the top makes it a little smaller and sits it lower, leaving a
     * clear strip between the title and the top of the demon's head. The strip
     * is not empty — the blurred backdrop shows through it.
     */
    padding-top: var(--headroom);
    background-origin: content-box;
  }

  /*
   * Dark enough to meet the painting's own black without a seam. The picture sits
   * lower than the band's top, so above it only the backdrop shows — and anything
   * lighter than the painting's ground draws a visible line straight across the
   * band where the two meet.
   */
  .plate--bleed .plate__backdrop {
    display: block;
    position: absolute;
    inset: 0;
    background-image: var(--plate-art);
    background-size: cover;
    background-position: center;
    filter: blur(36px) brightness(0.22) saturate(0.7);
    /* Scaled up so the blur's soft edge never reaches the band's own edge. */
    transform: scale(1.12);
  }

  /*
   * One wash from the left rather than two from the ends: the picture is dark at
   * the sides and lit in the middle, so the type sits on the dark and the figures
   * keep their light.
   */
  .plate--bleed .plate__art::after {
    background:
      /*
       * Solid black above the painting, fading out into the painting's own black
       * sky below it. The strip has to be solid or the blurred backdrop shows its
       * structure up there and draws the picture's top edge for the eye; and it has
       * to fade rather than stop, or hiding one edge simply makes another.
       */
      linear-gradient(
        to bottom,
        #000 0,
        #000 var(--headroom),
        rgb(0 0 0 / 0) calc(var(--headroom) + 7rem)
      ),
      linear-gradient(
        to right,
        rgb(10 5 3 / 0.9) 0%,
        rgb(10 5 3 / 0.72) 28%,
        rgb(10 5 3 / 0.25) 52%,
        rgb(10 5 3 / 0.1) 100%
      );
  }

  /*
   * Type to the top, as on a printed cover. It costs nothing here: the picture is
   * dark rock down its left edge at every height, so the title never needs the sky
   * and the band never needs extra canvas above the art.
   */
  .plate--bleed .plate__type {
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(1.75rem, 5vh, 3.25rem) clamp(1.25rem, 5vw, 4rem) 2rem;
  }

  /* The way in stays low, where a publisher's mark would be. */
  .plate--bleed .plate__foot {
    margin-top: auto;
  }

  .plate--bleed .plate__head,
  .plate--bleed .plate__foot {
    max-width: 30rem;
  }

  /*
   * Sized from the viewport, not from the plate: 11cqi of a full-width band is a
   * title four hundred pixels tall.
   */
  .plate--bleed .plate__eyebrow {
    font-size: clamp(0.6rem, 1.15vw, 0.85rem);
    letter-spacing: 0.16em;
    margin-bottom: 0.75rem;
  }

  .plate--bleed .plate__title {
    font-size: clamp(2.1rem, 5.6vw, 4.4rem);
    line-height: 0.98;
  }

  .plate--bleed .plate__lede {
    margin: 1rem 0 0;
    font-size: clamp(0.9rem, 1.5vw, 1.15rem);
  }



  .plate--bleed .plate__cta {
    padding: 0.7rem 1.6rem;
    font-size: clamp(0.72rem, 1.1vw, 0.9rem);
  }

  /*
   * On a phone the band stops being a band and becomes a stack.
   *
   * Overlaying type on a picture needs the picture to be big. A 3:2 painting at
   * 375px wide is 250px tall, so a tall band leaves it floating in the middle of
   * a lot of black with the type nowhere near it. Instead the picture takes its
   * own height, and the words sit under it on the dark ground.
   */
  @media (max-width: 34rem) {
    .plate--bleed {
      height: auto;
      aspect-ratio: auto;
      background: #0c0604;
    }

    .plate--bleed .plate__backdrop {
      display: none;
    }

    .plate--bleed .plate__art {
      position: relative;
      inset: auto;
      aspect-ratio: 3 / 2;
      background-size: cover;
      /* The masthead is above the picture here, not over it. */
      padding-top: 0;
    }

    /* Nothing is written on the picture now, so it keeps all of its own light. */
    .plate--bleed .plate__art::after {
      display: none;
    }

    .plate--bleed .plate__type {
      position: static;
      height: auto;
      align-items: center;
      text-align: center;
      padding: 1.5rem 1.25rem 2rem;
    }

    .plate--bleed .plate__head,
    .plate--bleed .plate__foot {
      max-width: none;
      margin-top: 0;
    }

    .plate--bleed .plate__lede {
      margin-bottom: 1.25rem;
    }
  }

  /* ── the switch ─────────────────────────────────────────────────────────── */

  /* Built for a shelf of them, not a pair: six labels wrap rather than squeeze. */
  /*
   * This is navigation, not a preference — it decides which book you are reading.
   * It is sized to say so.
   */
  .covers__switch {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: 1.4rem;
    font-family: var(--ui, system-ui, sans-serif);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .covers__switch[hidden] {
    display: none !important;
  }

  .covers__label {
    color: var(--ink-soft, #78644a);
    /* Stays with the first button rather than stranded on a line of its own. */
    margin-right: -0.25rem;
  }

  .covers__button {
    appearance: none;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    padding: 0.1rem 0 0.3rem;
    font: inherit;
    font-weight: 600;
    color: var(--ink-soft, #78644a);
    cursor: pointer;
  }

  .covers__button:hover {
    color: var(--orange, #b4551f);
  }

  .covers__button[aria-pressed='true'] {
    color: var(--orange, #b4551f);
    border-bottom-color: var(--orange, #b4551f);
  }

  .covers__label {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
  }

  .covers__resume {
    margin: 1.2rem 0 0;
    text-align: center;
    font-family: var(--ui, system-ui, sans-serif);
    font-size: 0.85rem;
  }

  .covers__resume[hidden] {
    display: none !important;
  }

  .covers__resume a {
    color: var(--orange, #b4551f);
    text-underline-offset: 0.25em;
  }

  /*
   * A printed shape is not always a screen shape. Below about 30rem a tall plate
   * is taller than the phone and a wide one is a letterbox, so each carries its
   * own narrow proportions.
   */
  @media (max-width: 30rem) {
    /*
     * Not the bleed plate: it stacks on a phone and takes its height from its
     * contents. This rule sits later in the file and would otherwise win on
     * source order, squash the band back to a square and clip the button off.
     */
    .plate:not(.plate--bleed) {
      aspect-ratio: var(--plate-aspect-narrow, 4 / 5);
    }
  }
</style>
