---
/**
 * The cover, as a cover — and there is more than one.
 *
 * Each cover is a plate: the art as a background with the title, the strapline
 * and the way in set over it. Title block high, the way in low where a
 * publisher's mark would sit.
 *
 * Scaling is the whole problem. A cover is a fixed set of proportions, and type
 * sized in rem stops being a cover the moment the plate is any other size. So each
 * plate is its own container and everything on it is sized in `cqi` — a percentage
 * of that plate's width — which holds the composition identically on a phone and
 * on a desktop. The clamps keep it readable at one end and sane at the other.
 *
 * The art is a background rather than an <img> because it is decoration: the title
 * is real text above it, which is what a screen reader and a search engine find.
 *
 * Every plate is rendered. The toggle swaps which one is shown and remembers the
 * choice per reader, and it only appears once the script has run — without
 * JavaScript the first cover shows and there is no dead control.
 */
interface Cover {
  id: string;
  image: string;
  label: string;
  /** Plate proportions, e.g. '5 / 7'. */
  aspect: string;
  /** How wide the plate may grow. A landscape plate wants more room. */
  maxWidth: string;
  /** Narrow-screen proportions, when the printed shape is too tall or too wide. */
  aspectNarrow?: string;
  /**
   * How far the scrims reach, as a percentage of plate height. A short plate puts
   * the same type block over more of the picture, so it needs them to reach further.
   */
  scrimTop?: string;
  scrimBottom?: string;
  /**
   * Whether this plate carries the strapline. A wide plate puts it straight over
   * the figures, and the fuller version sits directly below the cover anyway —
   * so the art is worth more than the repetition.
   */
  showLede?: boolean;
  /**
   * Break out of the page column and run edge to edge. A bleed plate is a band
   * rather than a book: it caps its height instead of holding proportions, sets
   * its type to one side so the picture keeps its middle, and scales from the
   * viewport rather than from its own width.
   */
  bleed?: boolean;
  /** background-position, for keeping the right part of the picture in frame. */
  focus?: string;
}

interface Props {
  covers: Cover[];
  eyebrow?: string;
  title: string;
  lede?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { covers, eyebrow, title, lede, ctaLabel, ctaHref } = Astro.props;
---

<div class="covers" data-covers>
  {
    covers.map((cover, i) => (
      <section
        class:list={['plate', cover.bleed && 'plate--bleed']}
        data-cover={cover.id}
        hidden={i !== 0}
        style={`--plate-art: url('${cover.image}'); --plate-aspect: ${cover.aspect}; --plate-max: ${cover.maxWidth}; --plate-aspect-narrow: ${cover.aspectNarrow ?? cover.aspect}; --scrim-top: ${cover.scrimTop ?? '44%'}; --scrim-bottom: ${cover.scrimBottom ?? '48%'}; --plate-focus: ${cover.focus ?? 'center'}`}
      >
        <div class="plate__art" aria-hidden="true" />

        <div class="plate__type">
          <header class="plate__head">
            {eyebrow && <p class="plate__eyebrow">{eyebrow}</p>}
            <h1 class="plate__title">{title}</h1>
          </header>

          <footer class="plate__foot">
            {lede && cover.showLede !== false && <p class="plate__lede">{lede}</p>}
            {ctaHref && ctaLabel && (
              <a class="plate__cta" href={ctaHref}>
                {ctaLabel}
              </a>
            )}
          </footer>
        </div>
      </section>
    ))
  }

  {
    covers.length > 1 && (
      <div class="covers__switch" data-cover-switch hidden>
        <span class="covers__label">Cover</span>
        {covers.map((cover, i) => (
          <button
            type="button"
            class="covers__button"
            data-cover-choose={cover.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {cover.label}
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  /**
   * Swap which plate is shown, and remember it. Storage is per browser and can
   * throw outright in a private window, so every touch of it is wrapped and the
   * page renders correctly when it fails.
   */
  const root = document.querySelector('[data-covers]');
  if (root) {
    const plates = Array.from(root.querySelectorAll<HTMLElement>('[data-cover]'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cover-choose]'));
    const bar = root.querySelector<HTMLElement>('[data-cover-switch]');
    const KEY = 'tna-cover';

    const show = (id: string, remember: boolean) => {
      const match = plates.some((p) => p.dataset.cover === id);
      if (!match) return;

      for (const plate of plates) plate.hidden = plate.dataset.cover !== id;
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.coverChoose === id));
      }
      if (remember) {
        try {
          window.localStorage.setItem(KEY, id);
        } catch {
          /* the choice holds for this page only */
        }
      }
    };

    let stored: string | null = null;
    try {
      stored = window.localStorage.getItem(KEY);
    } catch {
      /* undecided */
    }
    if (stored) show(stored, false);

    for (const button of buttons) {
      button.addEventListener('click', () => show(button.dataset.coverChoose ?? '', true));
    }

    // Only now is the control worth showing.
    if (bar) bar.hidden = false;
  }
</script>

<style>
  .covers {
    margin-bottom: 2.5rem;
  }

  .plate {
    container-type: inline-size;
    position: relative;
    width: 100%;
    max-width: var(--plate-max, 42rem);
    margin: 0 auto;
    aspect-ratio: var(--plate-aspect, 5 / 7);
    overflow: hidden;
    background: #241a12;
    border: 1px solid var(--rule, #b5a584);
  }

  .plate[hidden] {
    display: none !important;
  }

  .plate__art {
    position: absolute;
    inset: 0;
    background-image: var(--plate-art);
    background-size: cover;
    background-position: var(--plate-focus, center);
  }

  /*
   * Two scrims rather than one flat wash, so the painting keeps its middle and
   * only the ends darken under the type.
   */
  .plate__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgb(12 6 4 / 0.78) 0%,
        rgb(12 6 4 / 0.3) calc(var(--scrim-top, 44%) * 0.6),
        rgb(12 6 4 / 0) var(--scrim-top, 44%)
      ),
      linear-gradient(
        to top,
        rgb(12 6 4 / 0.88) 0%,
        rgb(12 6 4 / 0.5) calc(var(--scrim-bottom, 48%) * 0.45),
        rgb(12 6 4 / 0) var(--scrim-bottom, 48%)
      );
  }

  .plate__type {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 5cqi 6cqi;
    text-align: center;
    color: #f5ead6;
  }

  .plate__eyebrow {
    margin: 0 0 1.4cqi;
    font-family: var(--ui, system-ui, sans-serif);
    font-size: clamp(0.58rem, 2.3cqi, 0.95rem);
    font-weight: 600;
    /* Tracking this wide forces an ugly break on a narrow plate, so it eases off. */
    letter-spacing: clamp(0.08em, 0.5cqi, 0.18em);
    text-transform: uppercase;
    text-wrap: balance;
    color: #e8b88a;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.85);
  }

  .plate__title {
    margin: 0;
    font-family: var(--slab, Georgia, serif);
    font-weight: 400;
    font-size: clamp(1.9rem, 11cqi, 5.2rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-wrap: balance;
    text-shadow:
      0 2px 4px rgb(0 0 0 / 0.9),
      0 0 26px rgb(0 0 0 / 0.55);
  }

  .plate__lede {
    margin: 0 auto 3cqi;
    max-width: 34ch;
    font-family: var(--serif, Georgia, serif);
    font-size: clamp(0.78rem, 3.1cqi, 1.1rem);
    line-height: 1.45;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.95);
  }

  .plate__cta {
    display: inline-block;
    padding: 1.6cqi 5cqi;
    border: 1px solid #e8b88a;
    background: rgb(12 6 4 / 0.6);
    color: #f5ead6;
    font-family: var(--ui, system-ui, sans-serif);
    font-size: clamp(0.72rem, 2.8cqi, 1rem);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .plate__cta:hover,
  .plate__cta:focus-visible {
    background: #e8b88a;
    color: #241a12;
  }

  /* ── full bleed ─────────────────────────────────────────────────────────── */

  /*
   * Edge to edge, out of the page column. A band has no fixed proportions, so it
   * takes a capped height instead and lets the picture crop — which is why the
   * focus point is settable per cover.
   */
  .plate--bleed {
    width: 100vw;
    max-width: none;
    margin-left: calc(50% - 50vw);
    aspect-ratio: auto;
    height: clamp(21rem, 68vh, 40rem);
    border-left: 0;
    border-right: 0;
  }

  /*
   * One wash from the left rather than two from the ends: the picture is dark rock
   * at the sides and lit in the middle, so the type sits on the rock and the figure
   * keeps its light.
   */
  .plate--bleed .plate__art::after {
    background: linear-gradient(
      to right,
      rgb(10 5 3 / 0.9) 0%,
      rgb(10 5 3 / 0.72) 28%,
      rgb(10 5 3 / 0.25) 52%,
      rgb(10 5 3 / 0.1) 100%
    );
  }

  /*
   * Type to the top, as on a printed cover. It costs nothing here: the picture is
   * dark rock down its left edge at every height, so the title never needs the sky
   * and the band never needs extra canvas above the art.
   */
  .plate--bleed .plate__type {
    justify-content: flex-start;
    align-items: flex-start;
    text-align: left;
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(1.75rem, 5vh, 3.25rem) clamp(1.25rem, 5vw, 4rem) 2rem;
  }

  /* The way in stays low, where a publisher's mark would be. */
  .plate--bleed .plate__foot {
    margin-top: auto;
  }

  .plate--bleed .plate__head,
  .plate--bleed .plate__foot {
    max-width: 30rem;
  }

  /*
   * Sized from the viewport, not from the plate: 11cqi of a full-width band is a
   * title four hundred pixels tall.
   */
  .plate--bleed .plate__eyebrow {
    font-size: clamp(0.6rem, 1.15vw, 0.85rem);
    letter-spacing: 0.16em;
    margin-bottom: 0.75rem;
  }

  .plate--bleed .plate__title {
    font-size: clamp(2.1rem, 5.6vw, 4.4rem);
    line-height: 0.98;
  }

  .plate--bleed .plate__lede {
    margin: 1rem 0 0;
    font-size: clamp(0.9rem, 1.5vw, 1.15rem);
  }



  .plate--bleed .plate__cta {
    padding: 0.7rem 1.6rem;
    font-size: clamp(0.72rem, 1.1vw, 0.9rem);
  }

  /* On a phone the band is nearly square, so the type goes back to the middle. */
  @media (max-width: 34rem) {
    .plate--bleed .plate__type {
      align-items: center;
      text-align: center;
    }

    .plate--bleed .plate__art::after {
      background: linear-gradient(
        to top,
        rgb(10 5 3 / 0.86) 0%,
        rgb(10 5 3 / 0.55) 40%,
        rgb(10 5 3 / 0.35) 100%
      );
    }

    /* Tracked out, this line reaches both edges of a phone. */
    .plate--bleed .plate__eyebrow {
      letter-spacing: 0.1em;
      font-size: 0.6rem;
    }
  }

  /* ── the switch ─────────────────────────────────────────────────────────── */

  .covers__switch {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-top: 0.85rem;
    font-family: var(--ui, system-ui, sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .covers__switch[hidden] {
    display: none !important;
  }

  .covers__label {
    color: var(--ink-soft, #78644a);
  }

  .covers__button {
    appearance: none;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    padding: 0 0 0.15rem;
    font: inherit;
    color: var(--ink-soft, #78644a);
    cursor: pointer;
  }

  .covers__button:hover {
    color: var(--orange, #b4551f);
  }

  .covers__button[aria-pressed='true'] {
    color: var(--orange, #b4551f);
    border-bottom-color: var(--orange, #b4551f);
  }

  /*
   * A printed shape is not always a screen shape. Below about 30rem a tall plate
   * is taller than the phone and a wide one is a letterbox, so each carries its
   * own narrow proportions.
   */
  @media (max-width: 30rem) {
    .plate {
      aspect-ratio: var(--plate-aspect-narrow, 4 / 5);
    }
  }
</style>
